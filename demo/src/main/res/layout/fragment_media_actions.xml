<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <Button
        android:id="@+id/media_run_audio_scenario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:contentDescription="@string/media_run_audio_scenario"
        android:text="@string/button_media_run_audio_scenario" />

    <Button
        android:id="@+id/media_run_video_scenario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:contentDescription="@string/media_run_video_scenario"
        android:text="@string/button_media_run_video_scenario" />

</LinearLayout>
